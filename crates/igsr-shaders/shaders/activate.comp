// IGSR compute prelude: no `#version` line here; the backend prepends one
// (see backend::gl::compute_prelude).
//
// IGSR activate pass — 3-pass quality stage. Own implementation; role
// described in docs/ALGORITHM_NOTES.md §3: refine convert's disocclusion
// factor with a temporal depth test and track per-pixel luma deltas so the
// upscale pass can tell stable edges from shimmer.
//
// The temporal test mirrors the reference's gather pattern (stage 8C):
// previous-frame depths are gathered around PrevUV with offset gathers and
// bilinear weights, then tested against current depth with the Ksep
// separation metric. Like the reference, this samples the current depth
// buffer at the reprojected UV (single-buffer approximation — no separate
// previous-depth texture). Unlike the reference, the result is unioned
// (max) with convert's spatial disocclusion instead of replacing it, since
// ours exists and is valid signal; see ALGORITHM_NOTES §7.
//
// Differences from the studied design (deliberate): luma history is a plain
// RG float texture (luma, signed delta), not bit-packed halves in R32UI —
// integer image/atomics support is the riskiest item on crocus
// (ALGORITHM_NOTES §6.4), and floats cost little at render resolution.
// No transparency input yet (no opaque-color buffer until the testbed
// renders transparents); the edge flag rides in o_data.w instead of an
// alpha channel.
//
// I/O: u_data (motion.xy, spatial disocc, depth), u_color (render RGB),
// u_luma_prev (RG float history) → o_data (motion.xy, combined clip,
// edge flag), o_luma (RG float history). Convert's depth channel stays
// available for debug views; upscale keys off the combined clip.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_data;
uniform sampler2D u_color;
uniform sampler2D u_luma_prev;
layout(binding = 0, rgba16f) uniform writeonly image2D o_data;
layout(binding = 1, rg16f) uniform writeonly image2D o_luma;

uniform vec2 u_render_size;
uniform vec2 u_render_rcp;
uniform float u_reset;
uniform float u_fov_hor; // horizontal FOV factor for the Ksep metric

const float K_SEP = 1.4e-05; // same separation sensitivity as convert
const float EPS = 1.19e-07;

float luma_of(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float quad_min(vec4 g) {
    return min(min(g.x, g.y), min(g.z, g.w));
}

// One bilinear-weighted depth-agreement term. f_prev is the gathered
// previous depth reduced to a minimum, w is this tap's bilinear weight.
float agree(float f_prev, float depth, float sep_scale, float w) {
    float sep = sep_scale * (1.0 - min(f_prev, depth));
    return clamp(sep / (abs(f_prev - depth) + EPS), 0.0, 1.0) * w;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(u_render_size.x) || px.y >= int(u_render_size.y)) {
        return;
    }
    vec2 uv = (vec2(px) + vec2(0.5)) * u_render_rcp;

    vec4 md = texelFetch(u_data, px, 0);
    vec2 motion = md.xy;
    float spatial = md.z;
    float depth = md.w;

    // Temporal test: where did this pixel come from? Outside the viewport
    // means no valid history — fully disoccluded.
    vec2 prev_uv = uv - 0.5 * motion;
    bool inside = all(greaterThanEqual(prev_uv, vec2(0.0)))
        && all(lessThanEqual(prev_uv, vec2(1.0)));

    // Temporal depth comparison (reference gather pattern): gather previous
    // depths around PrevUV with offset gathers on the depth channel,
    // weight by bilinear position, test each against current depth.
    float temporal = 0.0;
    if (inside && depth < 1.0 - 1.0e-05) {
        vec2 prev_f = prev_uv * u_render_size - vec2(0.5);
        vec2 fr = prev_f - floor(prev_f);
        float bw[4] = float[4](
            (1.0 - fr.x) * (1.0 - fr.y),
            fr.x * (1.0 - fr.y),
            (1.0 - fr.x) * fr.y,
            fr.x * fr.y);
        float sep_scale = K_SEP * u_fov_hor * length(u_render_size);
        float wsum = 0.0;
        // Pair 0: gathers at (-1,-1) and (-1,0).
        vec4 g0 = textureGatherOffset(u_data, prev_uv, ivec2(-1, -1), 3);
        float f0 = quad_min(g0);
        wsum += agree(f0, depth, sep_scale, bw[0]);
        vec2 g0b = textureGatherOffset(u_data, prev_uv, ivec2(-1, 0), 3).zw;
        float f0b = min(min(g0b.x, g0b.y), min(g0.z, g0.w));
        wsum += agree(f0b, depth, sep_scale, bw[1]);
        // Pair 1: gathers at (0,-1) and (0,0).
        vec4 g1 = textureGatherOffset(u_data, prev_uv, ivec2(0, -1), 3);
        float f1 = quad_min(g1);
        wsum += agree(f1, depth, sep_scale, bw[2]);
        vec2 g1b = textureGatherOffset(u_data, prev_uv, ivec2(0, 0), 3).zw;
        float f1b = min(min(g1b.x, g1b.y), min(g1.z, g1.w));
        wsum += agree(f1b, depth, sep_scale, bw[3]);
        temporal = clamp(1.0 - wsum, 0.0, 1.0);
    }

    // Union of both tests (deliberate departure: the reference's convert
    // stores raw depth so its activate is temporal-only; ours keeps the
    // spatial term — dropping valid signal for parity would be worse).
    float clip = max(spatial, temporal);
    if (!inside) {
        clip = 1.0;
    }

    // Luma-delta tracking: a stable edge keeps its delta sign and shrinks
    // toward the smaller magnitude; a sign flip marks shimmer (edge flag).
    float cur = luma_of(texelFetch(u_color, px, 0).rgb);
    vec2 prev = textureLod(u_luma_prev, clamp(prev_uv, 0.0, 1.0), 0.0).rg;
    float out_luma = 0.0;
    float out_delta = 0.0;
    float edge = 0.0;
    if (inside && clip + u_reset < 0.1) {
        float delta = cur - prev.x;
        // Epsilon guard: without it, sub-quantization flicker on smooth
        // gradients (delta ~ 1e-5, sign random) flags edges everywhere.
        // The studied design has no guard, but its flag feeds a scaled
        // alpha term where tiny deltas self-attenuate; ours is binary.
        if (prev.y != 0.0 && abs(delta) > 1.0e-04) {
            if (sign(delta) == sign(prev.y)) {
                delta = sign(delta) * min(abs(prev.y), abs(delta));
            } else {
                edge = 1.0;
            }
        }
        out_luma = cur;
        out_delta = delta;
    }

    imageStore(o_data, px, vec4(motion, clamp(clip, 0.0, 1.0), edge));
    imageStore(o_luma, px, vec4(out_luma, out_delta, 0.0, 0.0));
}
