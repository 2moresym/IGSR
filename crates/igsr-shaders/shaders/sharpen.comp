// IGSR compute prelude: no `#version` line here; the backend prepends one
// (see backend::gl::compute_prelude).
//
// IGSR sharpen pass — compute variant. Own implementation of the published
// RCAS technique, same algorithm as sharpen.frag (5-tap cross, exact
// no-clip lobe solve, normalized resolve); only the dispatch differs (8x8
// work groups + imageStore). See sharpen.frag header for sourcing,
// assumptions, and the denoise note.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D u_image;
layout(binding = 0, rgba16f) uniform writeonly image2D o_sharp;

uniform vec2 u_display_size;
uniform float u_sharp;

const float LOBE_LIMIT = 0.1875;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(u_display_size);
    if (px.x >= size.x || px.y >= size.y) {
        return;
    }
    ivec2 hi = size - ivec2(1);
    vec3 n = texelFetch(u_image, ivec2(px.x, min(px.y + 1, hi.y)), 0).rgb;
    vec3 w = texelFetch(u_image, ivec2(max(px.x - 1, 0), px.y), 0).rgb;
    vec3 m = texelFetch(u_image, px, 0).rgb;
    vec3 e = texelFetch(u_image, ivec2(min(px.x + 1, hi.x), px.y), 0).rgb;
    vec3 s = texelFetch(u_image, ivec2(px.x, max(px.y - 1, 0)), 0).rgb;

    vec3 mn4 = min(min(n, w), min(e, s));
    vec3 mx4 = max(max(n, w), max(e, s));

    vec3 hit_min = min(mn4, m) / (vec3(4.0) * mx4);
    vec3 hit_max = (vec3(1.0) - max(mx4, m)) / (vec3(4.0) * mn4 - vec3(4.0));
    vec3 lobe_ch = max(-hit_min, hit_max);
    float lobe = max(-LOBE_LIMIT, min(max(max(lobe_ch.x, lobe_ch.y), lobe_ch.z), 0.0));
    lobe *= u_sharp;

    float rcp = 1.0 / (4.0 * lobe + 1.0);
    vec3 out_col = (lobe * (n + w + e + s) + m) * rcp;
    imageStore(o_sharp, px, vec4(out_col, 1.0));
}
